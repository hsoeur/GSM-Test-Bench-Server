{
  "UseSimulator": true,
  "Gsm": {
    "PortName": "COM7",
    "BaudRate": 115200,
    "ReadTimeout": 5000,
    "WriteTimeout": 5000
  },
  "GsmSimulator": {
    "CommandDelayMs": 50,
    "CallConnectDelayMs": 1500,
    "SimulateFailures": false,
    "FailurePercentage": 10,
    "CallFailurePercentage": 15,
    "PingFailurePercentage": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Api.TestGsm.Services": "Debug",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}