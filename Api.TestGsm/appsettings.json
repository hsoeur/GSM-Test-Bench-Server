{
  "App": {
    "CorsPolicyName": "AllowAll",
    "EnableSwagger": true,
    "SwaggerRoutePrefix": "swagger",
    "RootRedirectPath": "/swagger"
  },
  "SerilogFile": {
    "LogsDirectoryName": "logs",
    "DayFolderFormat": "yyyy-MM-dd",
    "FileNameFormat": "log-{0}-{1}.log",
    "FrameworkMinimumLevel": "Warning",
    "ConsoleOutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
    "FileOutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}",
    "FlushToDiskIntervalSeconds": 1
  },
  "ApiResponses": {
    "Init4GSuccessMessage": "4G module initialized successfully",
    "ModemTimeoutError": "Modem timeout",
    "InitializationFailedError": "Initialization failed",
    "PhoneNumberRequiredMessage": "phoneNumber required",
    "TimeoutDetectionText": "time out"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "UseSimulator": false,
  "Gsm": {
    "PortName": "COM6",
    "WindowsDefaultPortName": "COM3",
    "LinuxDefaultPortName": "/dev/ttyUSB0",
    "BaudRate": 115200,
    "DataBits": 8,
    "StopBits": "One",
    "Parity": "None",
    "Handshake": "None",
    "NewLine": "\n",
    "ReadTimeout": 5000,
    "WriteTimeout": 5000,
    "OpenDelayMs": 500,
    "ReadPollingDelayMs": 10,
    "WaitForTextPollingDelayMs": 1,
    "ExecGsmCommandSlackLines": 5,
    "ExecAndReadLineTimeoutMs": 1000,
    "ExecAndReadMaxIterations": 100,
    "CallStatusMaxAttempts": 25,
    "CallStatusPollingDelayMs": 500,
    "Protocol": {
      "VoiceDialCommandFormat": "ATDT{0};\r",
      "I2cPrompt": ">",
      "OkResponse": "\r\nOK\r\n",
      "ErrorResponse": "\r\nERROR\r\n",
      "ClccPrefix": "+CLCC:",
      "NoCarrierText": "NO CARRIER",
      "BusyText": "BUSY",
      "NoAnswerText": "NO ANSWER"
    },
    "Timeouts": {
      "TwoSecondsMs": 2000,
      "FiveSecondsMs": 5000,
      "TenSecondsMs": 10000,
      "FifteenSecondsMs": 15000,
      "TwentyFiveSecondsMs": 25000
    },
    "CommandSequences": {
      "TestCallConnectedResponses": [ "\r\nCONNECTED\r\n", "CONNECTED\r\n", "\r\nOK\r\n" ],
      "TestBenchInitialization": [
        { "Command": "AT\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CMEE=2\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CPIN?\r", "ExpectedResponses": [ "\r\n+CPIN: READY\r\n" ], "TimeoutKey": "2S" },
        { "Command": "ATZ\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "ATE0&W\r", "ExpectedResponses": [ "ATE0&W\r\r\nOK\r\n", "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CRC=1\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+COLP=0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+DDET=0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CHFA=2\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+SIDET=2,0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CEXTERNTONE=0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+ECHO?\r", "ExpectedResponses": [ "\r\n+ECHO: (0,96,253,16388,20488),(1,96,224,5256,20488)\r\n\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CMGF=1\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CSCS=\"IRA\"\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CREG?\r", "ExpectedResponses": [ "\r\n+CREG:0,1\r\n\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CGREG?\r", "ExpectedResponses": [ "\r\n+CGREG:0,1\r\n\r\nOK\r\n" ], "TimeoutKey": "2S" }
      ],
      "TestBenchInitializationFailureCleanup": [
        { "Command": "AT+DDET=0\r", "ExpectedResponses": [ "" ], "TimeoutMs": 0 }
      ],
      "FourGModuleInitialization": [
        { "Command": "ATE0\r", "ExpectedResponses": [ "ATE0\r\r\nOK\r\n", "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CPIN?\r", "ExpectedResponses": [ "\r\n+CPIN: READY\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT#ADSPC=1,0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT#DVICFG=0,1,2,1,2\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT#DVICFG=1,1,2,1,2\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT#DVI=1,2,1\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT#DVICLK=512,0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT#I2CWR=3,2,30,4,19\r", "Payload": "00101000240140002077404010502A0A400007\u001A", "TimeoutKey": "5S" },
        { "Command": "AT#I2CWR=3,2,30,17,1\r", "Payload": "8A\u001A", "TimeoutKey": "5S" },
        { "Command": "AT+CVHU=0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT#DIALMODE=2\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+CSQ\r", "RequiredText": "+CSQ:", "TimeoutKey": "5S" },
        { "Command": "AT+CREG?\r", "RequiredText": "+CREG:", "TimeoutKey": "5S" },
        { "Command": "AT+CEREG?\r", "RequiredText": "+CEREG:", "TimeoutKey": "5S", "ContinueOnFailure": true },
        { "Command": "AT#HFMICG=0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" }
      ],
      "AudioMarker": [
        { "Command": "AT+DDET=1\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" },
        { "Command": "AT+VTS=1\r", "ExpectedResponses": [ "\r\nOK\r\n", "\r\nOK\r\n\r\n+DTMF:1\r\n", "\r\nOK\r\n\r\n+DTMF:#\r\n", "\r\nOK\r\n\r\n+DTMF: #\r\n" ], "TimeoutKey": "5S" },
        { "Command": "AT+DDET=0\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" }
      ],
      "AudioMarkerFailureCleanup": [
        { "Command": "AT+DDET=0\r", "ExpectedResponses": [ "" ], "TimeoutMs": 0 }
      ],
      "TestCallFailureCleanup": [
        { "Command": "AT+DDET=0\r", "ExpectedResponses": [ "" ], "TimeoutMs": 0 }
      ],
      "HangUp": [
        { "Command": "+++\r", "ExpectedResponses": [ "" ], "TimeoutMs": 0 },
        { "Command": "ATH\r", "ExpectedResponses": [ "" ], "TimeoutMs": 0 }
      ],
      "Ping": [
        { "Command": "AT\r", "ExpectedResponses": [ "\r\nOK\r\n" ], "TimeoutKey": "2S" }
      ],
      "WaitForVoiceConnectedStatus": [
        { "Command": "AT+CLCC\r", "TimeoutKey": "5S" }
      ]
    }
  },
  "GsmSimulator": {
    "CommandDelayMs": 50,
    "CallConnectDelayMs": 2000,
    "SimulateFailures": false,
    "FailurePercentage": 10,
    "CallFailurePercentage": 15,
    "PingFailurePercentage": 5,
    "CallFailureMessage": "Simulated call failure: NO CARRIER"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  }
}
