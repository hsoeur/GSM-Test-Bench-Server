{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "UseSimulator": false,
  "Gsm": {
    "PortName": "COM6",
    "BaudRate": 115200,
    "DataBits": 8,
    "StopBits": "One",
    "Parity": "None",
    "Handshake": "None",
    "NewLine": "\n"
  },
  "GsmSimulator": {
    "CommandDelayMs": 50,
    "CallConnectDelayMs": 2000,
    "SimulateFailures": false,
    "FailurePercentage": 10,
    "CallFailurePercentage": 15,
    "PingFailurePercentage": 5
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  }
}
